# Copy this file to ".env" and fill in values.
# For local development the defaults in the committed .env already work.

# Local dev (SQLite): DATABASE_URL="file:./dev.db"
# Production (PostgreSQL): DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brilla?schema=public"
DATABASE_URL="file:./dev.db"

# Long random string for signing session cookies.
AUTH_SECRET="change-me"
